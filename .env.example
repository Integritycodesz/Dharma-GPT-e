# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LiveKit
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ElevenLabs TTS (keep the API key on the backend only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional voice IDs; when omitted, voices are selected from your account by persona.
# ELEVENLABS_VOICE_ID_KRISHNA=
# ELEVENLABS_VOICE_ID_CHANAKYA=
# ELEVENLABS_VOICE_ID_LAXMIBAI=
