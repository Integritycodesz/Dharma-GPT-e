# Copy this file to .env in this directory and add your own credentials.
# Never commit real API keys or secrets.

# Gemini (required for chat generation)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs text-to-speech (optional; Edge TTS is used when unset)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional voice IDs. If unset, voices are selected from your ElevenLabs account.
# ELEVENLABS_VOICE_ID_KRISHNA=
# ELEVENLABS_VOICE_ID_CHANAKYA=
# ELEVENLABS_VOICE_ID_LAXMIBAI=

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# LiveKit (only needed for the LiveKit voice agent)
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Optional backend settings
ALLOWED_ORIGINS=http://localhost:5173
MAX_SESSION_MINUTES=15
